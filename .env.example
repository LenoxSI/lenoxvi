# lenoxvi environment — copy to .env and fill in (never commit .env)
#
# SECRETS ONLY (2026-09-20): every behavior knob lives in config.yaml
# (wake threshold, VAD, STT model/device, TTS model, brain kind/
# url/model/zone, fillers). .env is the three secrets below plus the
# optional dashboard token, nothing else.
# A stray TK_* var here would be dead weight — config.yaml always wins
# (precedence: config.yaml > env > code default, see core/config.py).

# ElevenLabs (voice)
ELEVENLABS_API_KEY=
# your ElevenLabs voice id (account data — keep the real one out of git)
LVI_TTS_VOICE_ID=

# Hermes brain (API server auth)
LVI_HERMES_KEY=

# Dashboard mutating-route token (OPTIONAL — H5): leave empty for a
# trusted-LAN install (nothing changes). If set, POST/PUT/DELETE under
# /api/dashboard/ also require the X-Dashboard-Token header to match
# this value — for anyone who ignores the LAN-only advice or wants
# belt-and-suspenders. The dashboard page prompts for it once.
LVI_DASHBOARD_TOKEN=