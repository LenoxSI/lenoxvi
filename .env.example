# lenoxvi environment — copy to .env and fill in (never commit .env)

# ElevenLabs (the mouth)
ELEVENLABS_API_KEY=
LVI_TTS_VOICE_ID=            # Ivy's voice_id (from Hermes config)
LVI_TTS_MODEL=eleven_v3

# Local STT (the ears)
LVI_STT_MODEL=large-v3-turbo
LVI_STT_DEVICE=cuda
LVI_STT_COMPUTE=float16
LVI_STT_LANGUAGE=            # empty = auto-detect