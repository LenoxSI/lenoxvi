# LenoxVI environment — copy to .env and fill in (never commit .env)
#
# SECRETS ONLY (2026-09-20): every behavior knob lives in config.yaml
# (wake threshold, VAD, STT model/device, TTS model, intelligence kind/
# url/model/zone, fillers). .env holds the provider keys below, the voice
# id, and the optional dashboard token, nothing else.
# A stray LVI_* var here would be dead weight — config.yaml always wins
# (precedence: config.yaml > env > code default, see core/config.py).

# ElevenLabs (voice)
ELEVENLABS_API_KEY=
# your ElevenLabs voice id (account data — keep the real one out of git)
LVI_TTS_VOICE_ID=

# Deepgram (Aura-2 TTS — alternative provider, Settings tab)
DEEPGRAM_API_KEY=

# Intelligence keys — one per kind, read only by that kind
# (intelligence.kind in config.yaml; no cross-kind fallback). Set the one
# you use; the dashboard's Intelligence panel can also save it.
# Hermes (API server bearer key)
LVI_HERMES_KEY=
# OpenClaw (Gateway token)
LVI_OPENCLAW_KEY=
# Nanobot (its API server's key)
LVI_NANOBOT_KEY=
# A named Hermes profile (intelligence.agents.hermes: <profile>) uses that
# profile's own API_SERVER_KEY, saved as LVI_HERMES_KEY_<PROFILE> (upper
# case, - and . become _), e.g. LVI_HERMES_KEY_HOME_HELPER=

# Dashboard mutating-route token (OPTIONAL): leave empty for a
# trusted-LAN install (nothing changes). If set, POST/PUT/DELETE under
# /api/dashboard/ also require the X-Dashboard-Token header to match
# this value — for anyone who ignores the LAN-only advice or wants
# belt-and-suspenders. The dashboard page prompts for it once.
LVI_DASHBOARD_TOKEN=