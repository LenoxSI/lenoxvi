.DS_Store
*.swp
*~
.env
.env.*
!.env.example
logs/*
!logs/.gitkeep
__pycache__/
.venv/
venv/
node_modules/

# wake word models — stay local, never in GitHub
*.onnx

# agent-facing rule files — notes-backed, never GitHub
AGENTS.md
CLAUDE.md
# brand design kit — PRIVATE (NAS master: the design kit).
# Never GitHub, never in history (the owner, 2026-10-07). The React build bakes what
# the page renders into dashboard-ui/dist; this folder stays local-only.
design/
# runtime config — template is config.example.yaml
config.yaml
config.backup.yaml

# runtime artifacts — certs are regenerable per-host (make-cert.sh), clips
# are serve-on-only garbage, firmware/node is scp-populated by deploy_firmware.sh
# firmware/flex is the flex OTA track (deploy_firmware.sh --track flex) —
# flex images bake fallback WiFi creds, NEVER committable (036 M-8)
# firmware/xvf3800 is fetched at bring-up (fetch_xmos_fw.sh) — the upstream
# image ships no license, so it must not be committed (M15)
certs/
clips/
firmware/node/
firmware/flex/
firmware/xvf3800/
*.bundle

# sticky-session history stash (dashboard checkbox; holds conversation text)
data/
config.yaml.bak-*
