.DS_Store
*.swp
*~
.env
.env.*
!.env.example
logs/*
!logs/.gitkeep
__pycache__/
.venv/
venv/
node_modules/

# wake word models — stay local, never in GitHub
*.onnx

# agent-facing rule files — kept privately, never GitHub
AGENTS.md
CLAUDE.md
# brand design kit — PRIVATE (the master copy is kept outside the repo).
# Never GitHub, never in history. The React build bakes what
# the page renders into dashboard-ui/dist; this folder stays local-only.
design/
# runtime config — template is config.example.yaml
config.yaml
config.backup.yaml

# runtime artifacts — certs are regenerable per-host (make-cert.sh), clips
# are serve-on-only garbage, firmware/<track>/ (array, flex, waveshare) are the
# OTA tracks (dashboard upload / deploy_firmware.sh --track <track>) — built
# images, never committed
# firmware/xvf3800 is fetched at bring-up (fetch_xmos_fw.sh) — the upstream
# image ships no license, so it must not be committed
certs/
clips/
firmware/array/
firmware/flex/
firmware/waveshare/
firmware/xvf3800/
*.bundle

# sticky-session history stash (dashboard checkbox; holds conversation text)
data/
config.yaml.bak-*
