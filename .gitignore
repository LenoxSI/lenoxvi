.DS_Store
*.swp
*~
.env
.env.*
!.env.example
logs/*
!logs/.gitkeep
__pycache__/
.venv/
venv/
node_modules/

# wake word models — stay local, never in GitHub
*.onnx

# agent-facing rule files — notes-backed, never GitHub
AGENTS.md
CLAUDE.md
# runtime config — template is config.example.yaml
config.yaml
config.backup.yaml

# runtime artifacts — certs are regenerable per-host (make-cert.sh), clips
# are serve-once garbage, firmware/node is scp-populated by deploy_firmware.sh
# firmware/xvf3800 is fetched at bring-up (fetch_xmos_fw.sh) — the upstream
# image ships no license, so it must not be committed (M15)
certs/
clips/
firmware/node/
firmware/xvf3800/
*.bundle

# sticky-session history stash (dashboard checkbox; holds conversation text)
data/
config.yaml.bak-*
