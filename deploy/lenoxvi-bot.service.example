# lenoxvi-bot.service.example — sanitized copy of the production unit
# (the real launch config lived only on the appliance
# host, untracked — a fresh clone had no way to run the bot as a
# service). Adjust every <PLACEHOLDER>.
#
# Install as a systemd USER unit (no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/lenoxvi-bot.service.example ~/.config/systemd/user/lenoxvi-bot.service
#   # edit: venv path, --host IP
#   systemctl --user daemon-reload
#   systemctl --user enable --now lenoxvi-bot
#   journalctl --user -u lenoxvi-bot -f        # logs

[Unit]
Description=LenoxVI voice bot (pipecat appliance)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/projects/lenoxvi
# Secrets (.env: ELEVENLABS_API_KEY, LVI_TTS_VOICE_ID, LVI_HERMES_KEY) are
# read from the environment — the service loads them here. Never commit
# your .env; see .env.example.
EnvironmentFile=%h/projects/lenoxvi/.env
# Optional: keep runtime state out of the code folder (a read-only install).
# The bot then reads .env and certs/ from LVI_STATE_DIR (and clips, models,
# firmware, sessions); point LVI_CONFIG at the config there too, run
# scripts/make-cert.sh with the same LVI_STATE_DIR, and make EnvironmentFile
# name the same .env:
#   Environment=LVI_STATE_DIR=/var/lib/lenoxvi
#   Environment=LVI_CONFIG=/var/lib/lenoxvi/config.yaml
#   EnvironmentFile=/var/lib/lenoxvi/.env
# --host <bot-host-LAN-IP>: bind the LAN interface (0.0.0.0 works too;
# localhost does NOT — mic nodes and browsers connect from the LAN).
# --esp32: enable SDP munging for the ESP32-S3 mic nodes.
ExecStart=%h/venvs/lenoxvi/bin/python bot.py --host <bot-host-LAN-IP> --port 7860 --esp32
Restart=on-failure
RestartSec=5
# A stop takes ~2 s: the server gives node sessions a 2 s grace, then
# closes every connection (core/serve_opts.py). 10 s is the hard limit.
TimeoutStopSec=10

[Install]
WantedBy=default.target